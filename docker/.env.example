# Kopieren nach .env und ausfüllen. .env NIE ins Git-Repo einchecken.
N8N_DOMAIN=n8n.praxis-muster.de
DASHBOARD_DOMAIN=dashboard.praxis-muster.de
# Je ein langer Zufallswert, z. B. mit: openssl rand -hex 32
POSTGRES_PASSWORD=
N8N_ENCRYPTION_KEY=
N8N_RUNNERS_AUTH_TOKEN=
# Dieselben Werte auch in n8n als Credentials eintragen (siehe README, Schritt 3):
DASHBOARD_API_TOKEN=
DASHBOARD_INTERN_TOKEN=
# Bearer-Token, mit dem Vapi den n8n-Webhook aufruft (n8n-Credential "Vapi Bearer-Token"; vapi-einrichten.sh legt damit die Vapi-Credential an):
VAPI_WEBHOOK_TOKEN=
# Vom Skript docker/vapi-einrichten.sh verwaltet (nicht von Hand nötig): VAPI_API_KEY, VAPI_CREDENTIAL_ID, VAPI_ASSISTANT_ID, VAPI_NUMMER_ID
