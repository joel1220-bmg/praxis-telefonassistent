(sicherheit) {
	encode gzip
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		-Server
	}
}

{$N8N_DOMAIN} {
	import sicherheit
	# The dashboard API is only called by the dashboard inside the Docker network, never from outside.
	respond /webhook/praxis-dashboard* 403
	respond /webhook-test/praxis-dashboard* 403
	# Recommended: make the n8n editor reachable only from the practice network (webhooks stay public).
	# Replace 203.0.113.10 with the practice's public IP and remove the # signs.
	# @editor {
	# 	not path /webhook/*
	# 	not remote_ip 203.0.113.10
	# }
	# respond @editor 403
	reverse_proxy n8n:5678
}

{$DASHBOARD_DOMAIN} {
	import sicherheit
	# Callback requests come from n8n inside the Docker network, never from outside.
	respond /intern/* 403
	# Recommended as well: dashboard only from the practice network (same pattern as above).
	reverse_proxy dashboard:8080
}
