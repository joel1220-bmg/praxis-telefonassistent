(sicherheit) {
	encode gzip
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		-Server
	}
}

{$N8N_DOMAIN} {
	import sicherheit
	# From outside only the Vapi webhook gets through. The editor, REST API and dashboard API stay closed;
	# the editor is reached through an SSH tunnel (see README, "n8n editor (only through an SSH tunnel)").
	@vapi path /webhook/vapi-praxis
	handle @vapi {
		reverse_proxy n8n:5678
	}
	handle {
		respond 403
	}
}

{$DASHBOARD_DOMAIN} {
	import sicherheit
	# Callback requests come from n8n inside the Docker network, never from outside.
	respond /intern/* 403
	# Recommended as well: dashboard only from the practice network (same pattern as above).
	reverse_proxy dashboard:8080
}
